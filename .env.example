# Salin ke .env untuk development lokal. Di Coolify, isi di menu Environment Variables.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://tarbiyah:tarbiyah@localhost:5432/tarbiyah
DATA_DIR=./data
TZ=Asia/Jayapura

# 32 byte acak dalam base64. Buat dengan: openssl rand -base64 32
# Simpan juga di pengelola password: tanpa kunci ini secret di Pengaturan tidak bisa dibuka.
APP_ENCRYPTION_KEY=

# Kunci uji resmi Cloudflare Turnstile (selalu lolos). Ganti dengan kunci asli di staging/production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# true hanya bila trafik pasti lewat Cloudflare (server staging/production).
TRUST_CLOUDFLARE=false

# Admin awal untuk `pnpm db:seed` (hanya development/staging).
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
