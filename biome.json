{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!drizzle", "!coverage", "!graphify-out", "!**/*.css", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "linter": {
    "rules": { "preset": "none" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
